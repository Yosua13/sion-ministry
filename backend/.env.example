# Required database connection values. Never commit a populated .env file.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Comma-separated browser origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL=24h
INVITATION_TTL=72h
APP_PUBLIC_URL=http://localhost:5173
UPLOAD_DIR=./uploads
GEMINI_API_KEY=
# One-time bootstrap only: set both values through the deployment secret manager,
# start the application once, then remove both values. Never commit credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional error monitoring. Set only in the deployment secret manager.
SENTRY_DSN=

# Optional S3-compatible private object storage. AWS credentials use the standard
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY environment variables or workload identity.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=uploads
S3_USE_PATH_STYLE=false
S3_SIGNED_URL_TTL=15m
PORT=3000
APP_ENV=development

# SMTP is required in production. In development, an activation URL is written to
# the API log when SMTP is not configured; it is never returned by the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
# Short aliases also work for compatibility: SMTP_USER, SMTP_PASS, SMTP_SENDER.
# SMTP_FROM/SMTP_SENDER may be `Sion Ministry <noreply@example.com>`.
